# Deployment identity. Keep STACK_NAME stable to reuse database/result volumes.
STACK_NAME=accio-tpch
DEPLOY_MODE=compose
NETWORK_DRIVER=bridge

# Image names. For Swarm, use registry-qualified names and set DEPLOY_MODE=swarm.
ACCIO_COORDINATOR_IMAGE=accio-coordinator:latest
ACCIO_POSTGRES_IMAGE=accio-postgres:latest
POSTGRES_BASE_IMAGE=postgres:16-bookworm

# dbgen output paths. On Swarm these paths are resolved on the labeled source nodes.
TPCH_DATA_DIR_DB1=/absolute/path/to/tpch-dbgen-output
TPCH_DATA_DIR_DB2=/absolute/path/to/tpch-dbgen-output
TPCH_DATA_DIR_COORDINATOR=/absolute/path/to/tpch-dbgen-output

# Dataset and workload. Changing scale/placement requires fresh PostgreSQL volumes.
TPCH_SCALE=1
TPCH_PLACEMENT=v1

# Optional custom distribution. Leave empty to use TPCH_PLACEMENT's standard mapping.
# Coordinator tables are removed from the selected default PostgreSQL source.
# If DB1 or DB2 is overridden, set both and assign every table exactly once.
TPCH_TABLES_DB1="customer part supplier"
TPCH_TABLES_DB2="nation orders partsupp"
TPCH_TABLES_COORDINATOR="lineitem region"
# Example v1 override syntax:
# TPCH_TABLES_DB1="region nation supplier customer part partsupp"
# TPCH_TABLES_DB2="orders lineitem"
# Example: move region and nation from their default source into DuckDB:
# TPCH_TABLES_COORDINATOR="region nation"

# Database settings. Replace this password outside local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_SHARED_BUFFERS=1GB
PG_SHM_SIZE=2gb
PG_MAX_CONNECTIONS=100
PG_MAX_WORKERS=8
PG_PARALLEL_WORKERS_PER_GATHER=4
PG_MAX_PARALLELISM=8
DB_STATS_TARGET=100

# Per-source egress rate, for example 1gbit or 10gbit. Use none for real network speed.
BANDWIDTH=none

# DuckDB/Accio experiment settings. Empty ACCIO_QUERY runs all q*.sql files.
ACCIO_QUERY=
# Empty selects /opt/accio/workload/tpch2_${TPCH_PLACEMENT} in the image.
WORKLOAD_DIR=
ACCIO_RUNS=1
ACCIO_STRATEGY=benefit
ACCIO_CORES=4
ACCIO_MEMORY=8GB
COORDINATOR_MEMORY_LIMIT=10GB
ACCIO_EXPLAIN=false
STARTUP_TIMEOUT_SECONDS=7200

# Accio cost model.
COST_JOIN=2.0
COST_AGG=2.0
COST_SORT=2.0
COST_TRANSFER=10.0

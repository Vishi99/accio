# Deployment identity. Keep STACK_NAME stable to reuse source data volumes.
STACK_NAME=accio-tpch
DEPLOY_MODE=compose
NETWORK_DRIVER=bridge

# Image names. For Swarm, use registry-qualified names and set DEPLOY_MODE=swarm.
ACCIO_COORDINATOR_IMAGE=accio-mixed-coordinator:latest
ACCIO_POSTGRES_IMAGE=accio-postgres:latest
ACCIO_DUCKDB_IMAGE=accio-duckdb-source:latest
ACCIO_DATAFUSION_IMAGE=accio-datafusion-source:latest
ACCIO_COORDINATOR_DOCKERFILE=docker/coordinator/Dockerfile.mixed
DUCKDB_VERSION=1.5.3
POSTGRES_BASE_IMAGE=postgres:16-bookworm
# Legacy PostgreSQL-only coordinator build settings (unused by Dockerfile.mixed).
POSTGRESSCANNER_REPOSITORY=https://github.com/wangxiaoying/postgresscanner.git
# This upstream branch is intentionally spelled "prallel_query".
POSTGRESSCANNER_REF=prallel_query
# Scanner compilation concurrency. Reduce this if the Docker build runs out of memory.
POSTGRESSCANNER_BUILD_JOBS=4

# dbgen output paths. On Swarm these paths are resolved on the labeled source nodes.
TPCH_DATA_DIR_DB1=/absolute/path/to/tpch-dbgen-output
TPCH_DATA_DIR_DB2=/absolute/path/to/tpch-dbgen-output
TPCH_DATA_DIR_DB3=/absolute/path/to/tpch-dbgen-output
TPCH_DATA_DIR_DB4=/absolute/path/to/tpch-dbgen-output
TPCH_DATA_DIR_COORDINATOR=/absolute/path/to/tpch-dbgen-output

# Persistent host directory for lightweight timestamped benchmark logs.
# DuckDB database files are temporary and are not written here.
ACCIO_RESULTS_DIR=/absolute/path/to/accio-results

# Dataset and workload. After changing scale/placement, run the fresh command.
TPCH_SCALE=1
TPCH_PLACEMENT=v2

# Accio source registry. Add another name here, its DBn_* connection settings,
# and TPCH_TABLES_DBn after its Docker service exists. No Python change is needed.
ACCIO_SOURCES="db1 db2 db3 db4"
DB1_TYPE=POSTGRES
DB1_HOST=postgres1
DB1_PORT=5432
DB2_TYPE=POSTGRES
DB2_HOST=postgres2
DB2_PORT=5432
DB3_TYPE=DUCKDB
DB3_HOST=duckdb3
DB3_PORT=9494
DB3_TOKEN=replace-with-a-long-random-token
DB3_DISABLE_SSL=true
DB4_TYPE=DATAFUSION
DB4_HOST=datafusion4
DB4_PORT=5432
DB4_DATABASE=postgres
DB4_USERNAME=postgres
DB4_PASSWORD=unused

# Optional custom distribution. Leave empty to use TPCH_PLACEMENT's standard mapping.
# Every configured table must occur exactly once across the sources.
TPCH_TABLES_DB1="part partsupp"
TPCH_TABLES_DB2="region nation supplier customer"
TPCH_TABLES_DB3="lineitem"
TPCH_TABLES_DB4="orders"
TPCH_TABLES_COORDINATOR=
# Example v1 override syntax:
# TPCH_TABLES_DB1="region nation supplier customer part partsupp"
# TPCH_TABLES_DB2="orders lineitem"
# Four-source split based on v2:
# TPCH_TABLES_DB1="part partsupp"
# TPCH_TABLES_DB2="region nation supplier customer"
# TPCH_TABLES_DB3="lineitem"
# TPCH_TABLES_DB4="orders"
# Accio's current rewriters do not support coordinator-resident base tables;
# keep TPCH_TABLES_COORDINATOR empty for executable benchmark runs.

# Database settings. Replace this password outside local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_SHARED_BUFFERS=1GB
PG_SHM_SIZE=2gb
PG_MAX_CONNECTIONS=100
PG_MAX_WORKERS=8
PG_PARALLEL_WORKERS_PER_GATHER=4
PG_MAX_PARALLELISM=8
DB_STATS_TARGET=100

# DuckDB source settings.
DUCKDB_THREADS=4
DUCKDB_MEMORY=8GB

# Per-source egress rate, for example 1gbit or 10gbit. Use none for real network speed.
BANDWIDTH=none

# DuckDB/Accio experiment settings. Empty ACCIO_QUERY runs all q*.sql files.
ACCIO_QUERY=
# Empty selects /opt/accio/workload/tpch2_${TPCH_PLACEMENT} in the image.
WORKLOAD_DIR=
ACCIO_RUNS=1
ACCIO_STRATEGY=benefit
ACCIO_CORES=4
ACCIO_MEMORY=8GB
COORDINATOR_MEMORY_LIMIT=10GB
ACCIO_EXPLAIN=true
STARTUP_TIMEOUT_SECONDS=7200

# Accio cost model.
COST_JOIN=2.0
COST_AGG=2.0
COST_SORT=2.0
COST_TRANSFER=10.0

# One-machine JOB deployment: coordinator + PostgreSQL + DuckDB + DataFusion.
STACK_NAME=accio-job
DEPLOY_MODE=compose
NETWORK_DRIVER=bridge

ACCIO_COORDINATOR_IMAGE=accio-mixed-coordinator:latest
ACCIO_POSTGRES_IMAGE=accio-postgres:latest
ACCIO_DUCKDB_IMAGE=accio-duckdb-source:latest
ACCIO_DATAFUSION_IMAGE=accio-datafusion-source:latest
ACCIO_COORDINATOR_DOCKERFILE=docker/coordinator/Dockerfile.mixed
DUCKDB_VERSION=1.5.3
POSTGRES_BASE_IMAGE=postgres:16-bookworm

ACCIO_DATASET=job
ACCIO_DATASET_VERSION=job
ACCIO_DATASET_VARIANT=v2

# Each path is the JOB root. It may contain table CSVs directly or a csv/
# subdirectory. Large tables may use csv/<table>/*.csv.
ACCIO_DATA_DIR_DB1=/absolute/path/to/accio/data/job
ACCIO_DATA_DIR_DB3=/absolute/path/to/accio/data/job
ACCIO_DATA_DIR_DB4=/absolute/path/to/accio/data/job
ACCIO_DATA_DIR_COORDINATOR=/absolute/path/to/accio/data/job
ACCIO_RESULTS_DIR=/absolute/path/to/accio/accio-results

ACCIO_SOURCES="db1 db3 db4"

DB1_TYPE=POSTGRES
DB1_HOST=postgres1
DB1_PORT=5432
DB1_DATABASE=job

DB3_TYPE=DUCKDB
DB3_HOST=duckdb3
DB3_PORT=9494
DB3_TOKEN=replace-with-a-long-random-token
DB3_DISABLE_SSL=true

DB4_TYPE=DATAFUSION
DB4_HOST=datafusion4
DB4_PORT=5432
DB4_DATABASE=postgres
DB4_USERNAME=postgres
DB4_PASSWORD=unused
DATAFUSION_FETCH_BATCH_ROWS=100000

# Three-way JOB placement. The original pg1/pg2/pg3 labels map to the Docker
# sources by engine: pg1 -> DuckDB/db3, pg2 -> DataFusion/db4, pg3 -> PostgreSQL/db1.
# Every table must occur exactly once.
ACCIO_TABLES_DB1="aka_title company_name company_type keyword kind_type movie_companies movie_keyword"
ACCIO_TABLES_DB3="aka_name cast_info char_name info_type person_info role_type name"
ACCIO_TABLES_DB4="complete_cast comp_cast_type link_type title movie_info movie_info_idx movie_link"
ACCIO_TABLES_COORDINATOR=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_SHARED_BUFFERS=1GB
PG_SHM_SIZE=2gb
PG_MAX_CONNECTIONS=100
PG_MAX_WORKERS=8
PG_PARALLEL_WORKERS_PER_GATHER=4
PG_MAX_PARALLELISM=8
DB_STATS_TARGET=100

DUCKDB_THREADS=4
DUCKDB_MEMORY=8GB
BANDWIDTH=none

# Query basenames include a suffix, for example q01a or q33c. Empty runs all.
ACCIO_QUERY=q01a
WORKLOAD_DIR=/opt/accio/workload/fqp_job
ACCIO_RUNS=1
ACCIO_STRATEGY=benefit
ACCIO_CORES=4
ACCIO_MEMORY=8GB
COORDINATOR_MEMORY_LIMIT=10GB
ACCIO_EXPLAIN=true
STARTUP_TIMEOUT_SECONDS=7200

COST_JOIN=2.0
COST_AGG=2.0
COST_SORT=2.0
COST_TRANSFER=10.0

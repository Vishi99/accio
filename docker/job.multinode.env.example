# Coordinator configuration for a four-node physical JOB deployment.
# node-0 (10.10.1.1) runs this coordinator configuration.
# Source containers are started independently on their respective machines.
STACK_NAME=accio-job
ACCIO_COORDINATOR_IMAGE=accio-mixed-coordinator:latest

ACCIO_DATASET=job
ACCIO_DATASET_VERSION=job
ACCIO_DATASET_VARIANT=v2
ACCIO_SOURCES="db1 db3 db4"

# node-1 (10.10.1.4): PostgreSQL, logical pg3 placement
DB1_TYPE=POSTGRES
DB1_HOST=10.10.1.4
DB1_PORT=5432
DB1_DATABASE=job
DB1_USERNAME=postgres
DB1_PASSWORD=postgres

# node-3 (10.10.1.3): DuckDB served through Quack, logical pg1 placement
DB3_TYPE=DUCKDB
DB3_HOST=10.10.1.3
DB3_PORT=9494
DB3_TOKEN=replace-with-a-long-random-token
DB3_DISABLE_SSL=true

# node-2 (10.10.1.2): DataFusion served through PGWire, logical pg2 placement
DB4_TYPE=DATAFUSION
DB4_HOST=10.10.1.2
DB4_PORT=5432
DB4_DATABASE=postgres
DB4_USERNAME=postgres
DB4_PASSWORD=unused
DATAFUSION_FETCH_BATCH_ROWS=100000

ACCIO_TABLES_DB1="aka_title company_name company_type keyword kind_type movie_companies movie_keyword"
ACCIO_TABLES_DB3="aka_name cast_info char_name info_type person_info role_type name"
ACCIO_TABLES_DB4="complete_cast comp_cast_type link_type title movie_info movie_info_idx movie_link"
ACCIO_TABLES_COORDINATOR=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_MAX_PARALLELISM=8

# This path exists only on the coordinator node.
ACCIO_RESULTS_DIR=/users/Vishak/accio/accio-results

ACCIO_QUERY=q01a
WORKLOAD_DIR=/opt/accio/workload/fqp_job
ACCIO_RUNS=1
ACCIO_STRATEGY=benefit
ACCIO_CORES=4
ACCIO_MEMORY=8GB
COORDINATOR_MEMORY_LIMIT=10GB
ACCIO_EXPLAIN=true
STARTUP_TIMEOUT_SECONDS=7200

COST_JOIN=2.0
COST_AGG=2.0
COST_SORT=2.0
COST_TRANSFER=10.0
